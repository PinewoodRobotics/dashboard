[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]
macos.debug = "../target/release/libgodot_bridge.dylib"
macos.release = "../target/release/libgodot_bridge.dylib"
windows.debug.arm64 = "../target/release/godot_bridge.dll"
windows.release.arm64 = "../target/release/godot_bridge.dll"
windows.debug.x86_64 = "../target/release/godot_bridge.dll"
windows.release.x86_64 = "../target/release/godot_bridge.dll"
