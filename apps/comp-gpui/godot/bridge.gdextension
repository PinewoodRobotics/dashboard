[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]
macos.debug = "res://bin/libgodot_bridge.dylib"
macos.release = "res://bin/libgodot_bridge.dylib"
windows.debug.arm64 = "res://bin/godot_bridge.dll"
windows.release.arm64 = "res://bin/godot_bridge.dll"
windows.debug.x86_64 = "res://bin/godot_bridge.dll"
windows.release.x86_64 = "res://bin/godot_bridge.dll"
