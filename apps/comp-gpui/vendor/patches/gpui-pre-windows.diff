+
+struct OpenedSharedTexture {
+    view: Option<ID3D11ShaderResourceView>,
+    size: Size<DevicePixels>,
+}
+
+struct SharedTextureEntry {
+    texture: Option<OpenedSharedTexture>,
+    last_used_frame: u64,
+}
+
+/// Textures opened from other processes, keyed by handle name. A name is opened once and kept
+/// while scenes keep painting it. A failed open is cached as well, so it is retried only after
+/// the entry has been evicted.
+#[derive(Default)]
+struct SharedTextureCache {
+    entries: FxHashMap<SharedString, SharedTextureEntry>,
+    frame: u64,
+}
+
+impl SharedTextureCache {
+    const EVICT_AFTER_FRAMES: u64 = 60;
+
+    fn clear(&mut self) {
+        self.entries.clear();
+    }
+
+    fn open(
+        &mut self,
+        device: &ID3D11Device,
+        shared: &SharedTexture,
+    ) -> Option<&OpenedSharedTexture> {
+        let frame = self.frame;
+        let entry = self
+            .entries
+            .entry(shared.name.clone())
+            .or_insert_with(|| SharedTextureEntry {
+                texture: open_shared_texture(device, &shared.name)
+                    .with_context(|| format!("opening shared texture {}", shared.name))
+                    .log_err(),
+                last_used_frame: frame,
+            });
+        entry.last_used_frame = frame;
+        entry.texture.as_ref()
+    }
+
+    fn end_frame(&mut self) {
+        self.frame += 1;
+        let frame = self.frame;
+        self.entries
+            .retain(|_, entry| frame - entry.last_used_frame <= Self::EVICT_AFTER_FRAMES);
+    }
+}
+
+fn open_shared_texture(device: &ID3D11Device, name: &str) -> Result<OpenedSharedTexture> {
+    let device1: ID3D11Device1 = device.cast()?;
+    let texture: ID3D11Texture2D = unsafe {
+        device1.OpenSharedResourceByName(&HSTRING::from(name), DXGI_SHARED_RESOURCE_READ.0)
+    }?;
+    let mut desc = D3D11_TEXTURE2D_DESC::default();
+    unsafe { texture.GetDesc(&mut desc) };
+    let mut view = None;
+    unsafe { device.CreateShaderResourceView(&texture, None, Some(&mut view)) }?;
+    Ok(OpenedSharedTexture {
+        view,
+        size: size(DevicePixels(desc.Width as i32), DevicePixels(desc.Height as i32)),
+    })
+}
