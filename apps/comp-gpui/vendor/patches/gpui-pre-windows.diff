+fn surface_sprite(surface: &PaintSurface, texture_size: Size<DevicePixels>) -> PolychromeSprite {
+    PolychromeSprite {
+        order: surface.order,
+        // polychrome_sprite_fragment reads a nonzero pad as "force alpha to one".
+        pad: surface.shared_texture.opaque as u32,
+        tile: AtlasTile {
+            texture_id: AtlasTextureId {
+                index: 0,
+                kind: AtlasTextureKind::Polychrome,
+            },
+            tile_id: TileId(0),
+            padding: 0,
+            bounds: Bounds {
+                origin: Point::default(),
+                size: texture_size,
+            },
+        },
+        grayscale: false.into(),
+        opacity: 1.0,
+        bounds: surface.bounds,
+        content_mask: surface.content_mask.clone(),
+        corner_radii: Corners::default(),
+    }
