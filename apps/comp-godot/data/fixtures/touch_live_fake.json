{
  "extends": "touch_live_robot3d",
  "input": [
    {"wait_ms": 300},
    {"expect": {"robot3d.turret.disabled": true, "robot3d.turret.value": {"near": -1.5708, "tol": 0.01},
      "robot3d.index_wrist.disabled": true, "robot3d.climber_inner.disabled": false, "max_rendering_views": {"le": 1}}},
    {"tap": "LeftRail/Home"},
