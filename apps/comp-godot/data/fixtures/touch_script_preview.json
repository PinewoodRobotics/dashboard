{
  "extends": "touch_m6_base",
  "touch": {"active_tab": "auto", "view_auto": "Climber Right Middle"},
  "preview": {"realtime": true},
  "input": [
    {"expect": {"auto_tab.preview.auto": "Climber Right Middle", "autos.duration": {"near": 7.16, "tol": 1e-6}, "autos.playing": false,
      "auto_tab.preview.rendering": true, "max_rendering_views": {"le": 2}}},
    {"tap": "find:Speed_2_0"},
    {"expect": {"autos.speed": 2.0}},
    {"tap": "find:PlayPause"},
    {"expect": {"autos.playing": true, "auto_tab.preview.play_icon": "pause"}},
    {"wait_ms": 1500, "screenshot": "playing"},
    {"expect": {"autos.hud.mirror": true, "autos.hud.auto": "Climber Right Middle"}},
    {"wait_for": {"autos.playing": false}, "timeout_ms": 6000},
    {"expect": {"autos.last_run.wall_s": {"near": 3.58, "tol": 0.0358}, "autos.t": {"near": 7.16, "tol": 1e-6}, "autos.hud.mirror": false}},
    {"tap": "find:Speed_1_0"},
    {"tap": "find:PlayPause"},
    {"wait_for": {"autos.playing": false}, "timeout_ms": 9000},
    {"expect": {"autos.last_run.wall_s": {"near": 7.16, "tol": 0.0716}, "autos.last_run.speed": 1.0}},
    {"tap": "find:Speed_0_5"},
    {"tap": "find:PlayPause"},
    {"wait_for": {"autos.playing": false}, "timeout_ms": 16000},
    {"expect": {"autos.last_run.wall_s": {"near": 14.32, "tol": 0.1432}, "autos.last_run.speed": 0.5}},
    {"tap": "find:Speed_1_0"},
    {"tap": "find:PlayPause"},
    {"wait_ms": 600},
    {"tap": "find:PlayPause"},
    {"mark": "paused"},
    {"expect": {"autos.playing": false, "auto_tab.preview.play_icon": "play", "autos.t": {"ge": 0.4}}},
    {"wait_ms": 400},
    {"expect": {"autos.t": {"same_as": "paused", "tol": 1e-9}}},
    {"drag": {"from": {"node": "find:Scrub", "offset": [-200, 30]}, "to": {"node": "find:Scrub", "offset": [0, 30]}, "ms": 300, "release": false}},
    {"expect": {"autos.scrubbing": true, "autos.t": {"near": 3.58, "tol": 0.02}, "auto_tab.preview.robot_error_m": {"le": 1e-4},
      "auto_tab.preview.robot_yaw_error": {"le": 1e-4}, "state.active_tab": "auto", "autos.hud.mirror": true}},
    {"release": {"node": "find:Scrub", "offset": [0, 30]}},
    {"expect": {"autos.scrubbing": false, "autos.playing": false, "autos.t": {"near": 3.58, "tol": 0.02}}},
    {"drag": {"from": {"node": "find:Scrub", "offset": [100, 30]}, "to": {"node": "find:Scrub", "offset": [100, 300]}, "ms": 250}},
    {"wait_ms": 400},
    {"expect": {"state.active_tab": "auto", "touch.overlay.tabs": ["auto"], "auto_tab.preview.robot_error_m": {"le": 1e-4}}},
    {"tap": "find:Loop"},
    {"expect": {"autos.loop": true}},
    {"tap": {"node": "find:Scrub", "offset": [310, 30]}},
    {"expect": {"autos.t": {"ge": 6.8}}},
    {"tap": "find:PlayPause"},
    {"wait_ms": 900},
    {"expect": {"autos.playing": true, "autos.t": {"le": 1.0}}},
    {"tap": "find:PlayPause"},
    {"tap": "find:CameraMode"},
    {"expect": {"auto_tab.preview.camera": "Field"}},
    {"tap": "find:Alliance"},
    {"expect": {"autos.alliance": "blue", "auto_tab.preview.alliance_enabled": false}},
    {"inject": {"/matchhud/state/is_red_alliance": null}},
    {"expect": {"auto_tab.preview.alliance_enabled": true}},
    {"tap": "find:Alliance"},
    {"expect": {"autos.alliance": "blue", "autos.alliance_known": false}},
    {"tap": "find:Alliance"},
    {"expect": {"autos.alliance": "red"}, "screenshot": "red_field"}
  ]
}
