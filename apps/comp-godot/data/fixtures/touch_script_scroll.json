{
  "extends": "touch_m6_base",
  "touch": {"open_panel": "intakeSpeed"},
  "input": [
    {"wait_ms": 300},
    {"inject": {"/AdvantageKit/NetworkInputs/Tuning/Turret/AimTrimDeg": 2.5}},
    {"expect": {"scrolls.IntakeScroll.offset": 0.0, "scrolls.IntakeScroll.max": {"ge": 150}, "intake_panel.trim": 2.5}},
    {"mark": "m0"},
    {"drag": {"from": {"node": "find:Speed", "at": [220, 60]}, "to": {"node": "find:Speed", "at": [230, -340]}, "ms": 300}},
    {"wait_ms": 100},
    {"expect": {"scrolls.IntakeScroll.offset": {"ge": 150}, "scrolls.IntakeScroll.dragging": false,
      "intake_panel.speed": {"same_as": "m0", "tol": 0.0}, "state.open_panel": "intakeSpeed"}},
    {"screenshot": "intake_scrolled"},
    {"tap": "find:Center"},
    {"wait_ms": 100},
    {"expect": {"intake_panel.trim": 0.0}},
    {"mouse": true},
    {"drag": {"from": {"node": "find:IntakeScroll", "offset": [0, -150]}, "to": {"node": "find:IntakeScroll", "offset": [0, 200]}, "ms": 250}},
    {"wait_ms": 100},
    {"expect": {"scrolls.IntakeScroll.offset": 0.0}},
    {"drag": {"from": {"node": "find:IntakeScroll", "offset": [0, 150]}, "to": {"node": "find:IntakeScroll", "offset": [0, 50]}, "ms": 250}},
    {"wait_ms": 100},
    {"expect": {"scrolls.IntakeScroll.offset": {"near": 84, "tol": 6}}},
    {"mouse": false},
    {"tap": "RightDrawer/Panel_showMap"},
    {"wait_ms": 400},
    {"expect": {"state.open_panel": "showMap", "scrolls.MapScroll.max": {"ge": 50}}},
    {"mark": "m1"},
    {"drag": {"from": {"node": "find:Zoom", "at": [200, 60]}, "to": {"node": "find:Zoom", "at": [210, -260]}, "ms": 300}},
    {"wait_ms": 100},
    {"expect": {"scrolls.MapScroll.offset": {"ge": 50}, "settings.map": {"same_as": "m1"}, "state.open_panel": "showMap"}},
    {"screenshot": "map_scrolled"}
  ]
}
