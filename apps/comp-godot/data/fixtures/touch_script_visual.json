{
  "extends": "touch_base",
  "touch": {"active_tab": "visual"},
  "input": [
    {"expect": {"views.0.scale": 1.0, "views.1.scale": 1.0, "engine.max_fps": 60, "visual_tab.save_enabled": false}},
    {"drag": {"from": {"node": "find:RenderScale", "at": [300, 68]}, "to": {"node": "find:RenderScale", "at": [30, 68]}, "ms": 250}},
    {"expect": {"settings.visual.render_scale": 1.0, "visual_tab.draft.render_scale": 0.25, "visual_tab.save_enabled": true}},
    {"tap": "find:Save"},
    {"expect": {"settings.visual.render_scale": 0.25, "views.0.scale": 0.25, "views.1.scale": 0.25, "visual_tab.save_enabled": false}},
    {"drag": {"from": {"node": "find:RenderScale", "at": [100, 68]}, "to": {"node": "find:RenderScale", "at": [200, 68]}, "ms": 250}},
    {"tap": {"node": "find:Msaa", "at": [40, 84]}},
    {"tap": {"node": "find:FpsCap", "at": [40, 84]}},
    {"expect": {"settings.visual.render_scale": 0.25, "settings.visual.msaa": 2, "visual_tab.draft.msaa": 0, "visual_tab.draft.fps_cap": 30}},
    {"tap": "find:Save"},
    {"wait_ms": 100},
    {"expect": {"settings.visual.render_scale": 0.5, "views.0.scale": 0.5, "views.1.scale": 0.5, "settings.visual.msaa": 0, "views.0.msaa": 0,
      "views.1.msaa": 0, "settings.visual.fps_cap": 30, "engine.max_fps": 30}},
    {"screenshot": "changed"},
    {"tap": {"node": "find:BackdropBlur", "at": [40, 84]}},
    {"screenshot": "draft"},
    {"tap": "find:ReloadModels"},
    {"wait_ms": 300},
    {"expect": {"models.generation.robot": 2, "models.generation.field": 2, "views.0.loaded": true, "views.1.loaded": true}},
    {"tap": "find:Reset"},
    {"expect": {"settings.visual": {"render_scale": 1.0, "msaa": 2, "fps_cap": 60, "auto_quality": true, "backdrop_blur": true}, "views.0.scale": 1.0, "views.0.msaa": 1, "engine.max_fps": 60,
      "visual_tab.draft.backdrop_blur": true, "visual_tab.save_enabled": false}},
    {"tap": {"node": "find:RenderScale", "at": [300, 68]}},
    {"expect": {"visual_tab.draft.render_scale": 1.0, "visual_tab.save_enabled": false}},
    {"drag": {"from": {"node": "find:RenderScale", "at": [300, 68]}, "to": {"node": "find:RenderScale", "at": [210, 68]}, "ms": 250}},
    {"tap": {"node": "find:Msaa", "at": [190, 84]}},
    {"tap": {"node": "find:FpsCap", "at": [40, 84]}},
    {"tap": "find:Save"},
    {"expect": {"settings.visual": {"render_scale": 0.75, "msaa": 4, "fps_cap": 30, "auto_quality": true, "backdrop_blur": true}}},
    {"call": "save_settings"}
  ]
}
