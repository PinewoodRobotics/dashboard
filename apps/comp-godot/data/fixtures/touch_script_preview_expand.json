{"extends": "touch_m6_base",
 "nt": {"/matchhud/state/is_red_alliance": true},
 "touch": {"active_tab": "auto", "view_auto": "Ball Shooter Left"},
 "preview": {"t": 8.0},
 "input": [
  {"expect": {"auto_tab.expanded": false, "auto_tab.list_visible": true, "auto_tab.preview.view_camera.user": false, "auto_tab.preview.reset_view": false}},
  {"mark": "small"},
  {"tap": "find:Expand"},
  {"wait_ms": 200},
  {"expect": {"auto_tab.expanded": true, "auto_tab.list_visible": false, "auto_tab.preview.expanded": true,
    "auto_tab.preview.view_size.0": {"ge": 1500}, "auto_tab.preview.view_size.1": {"ge": 380},
    "auto_tab.preview.scrub.compact": true, "auto_tab.preview.view_camera.robot_px": {"ratio_since": "small", "ge": 1.3}}},
  {"screenshot": "expanded"},
  {"drag": {"from": {"node": "find:PreviewView", "offset": [-150, 0]}, "to": {"node": "find:PreviewView", "offset": [50, -40]}, "ms": 300}},
  {"expect": {"auto_tab.preview.view_camera.user": true, "auto_tab.preview.reset_view": true, "auto_tab.preview.view_camera.yaw": {"changed_since": "small"},
    "state.active_tab": "auto", "touch.overlay.tabs": ["auto"]}},
  {"mark": "orbited"},
  {"pinch": {"at": "find:PreviewView", "from": 160, "to": 400, "pan": [0, 0], "ms": 300}},
  {"expect": {"auto_tab.preview.view_camera.dist": {"le": 5.0}, "state.active_tab": "auto"}},
  {"mark": "zoomed"},
  {"pinch": {"at": "find:PreviewView", "from": 300, "to": 300, "pan": [180, 60], "ms": 300}},
  {"expect": {"auto_tab.preview.view_camera.target": {"changed_since": "zoomed"}, "auto_tab.preview.view_camera.dist": {"same_as": "zoomed", "tol": 0.05}}},
  {"screenshot": "orbited"},
  {"tap": "find:ResetView"},
  {"expect": {"auto_tab.preview.view_camera.user": false, "auto_tab.preview.reset_view": false}},
  {"tap": "find:Expand"},
  {"wait_ms": 200},
  {"expect": {"auto_tab.expanded": false, "auto_tab.list_visible": true, "auto_tab.preview.view_size.0": {"le": 800},
    "auto_tab.preview.scrub.compact": false, "auto_tab.preview.view_camera.robot_px": {"same_as": "small", "tol": 0.5}}}
 ]}
