{
  "extends": "touch_base",
  "input": [
    {"expect": {"state.rail": ["auto", "howard", "settings"], "state.dock": ["visual", "auto", "settings", "effects", "howard", "robot3d"]}},
    {"mouse": true},
    {"tap": "LeftRail/DockToggle"},
    {"wait_ms": 200},
    {"drag": {"from": "LeftRail/rail_howard", "to": "Dock/dock_effects", "ms": 200}},
    {"expect": {"state.rail": ["auto", "settings"]}},
    {"drag": {"from": "LeftRail/rail_settings", "to": {"node": "LeftRail/rail_auto", "offset": [0, -10]}, "ms": 200}},
    {"expect": {"state.rail": ["settings", "auto"]}},
    {"drag": {"from": "Dock/dock_robot3d", "to": "Dock/dock_visual", "ms": 200}},
    {"expect": {"state.dock": ["robot3d", "visual", "auto", "settings", "effects", "howard"]}},
    {"drag": {"from": "Dock/dock_effects", "to": [960, 200], "ms": 200}},
    {"expect": {"state.rail": ["settings", "auto"], "state.dock": ["robot3d", "visual", "auto", "settings", "effects", "howard"]}},
    {"tap": "LeftRail/DockToggle"},
    {"wait_ms": 200},
    {"expect": {"state.dock_open": false}},
    {"drag": {"from": "LeftRail/rail_auto", "to": "LeftRail/rail_settings", "ms": 200}},
    {"expect": {"state.rail": ["settings", "auto"], "state.active_tab": ""}},
    {"call": "save_settings"}
  ]
}
