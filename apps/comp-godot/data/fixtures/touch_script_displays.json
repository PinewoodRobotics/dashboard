{
  "extends": "touch_base",
  "touch": {"active_tab": "visual"},
  "input": [
    {"expect": {"kiosk.retiles": 0, "settings.windows.hud_screen": -1, "settings.windows.touch_screen": -1}},
    {"tap": {"node": "find:HudScreen", "at": [191, 74]}},
    {"expect": {"settings.windows.hud_screen": 1, "kiosk.retiles": 1, "kiosk.plan.touch.mode": "windowed"}},
    {"tap": {"node": "find:TouchScreen", "at": [40, 74]}},
    {"expect": {"settings.windows.touch_screen": -1, "kiosk.retiles": 1}},
    {"tap": "find:Retile"},
    {"expect": {"kiosk.retiles": 2, "kiosk.plan.touch.reason": "no 1920x515 display"}, "screenshot": "after"}
  ]
}
