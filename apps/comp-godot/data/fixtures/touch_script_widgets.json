{
  "extends": "touch_base",
  "touch": {"dev_tab": "gallery"},
  "input": [
    {"expect": {"gallery.speed": 0.15, "gallery.trim": 2.5, "gallery.mode": "follow", "gallery.msaa": 2}},
    {"tap": {"node": "find:Speed", "at": [380, 60]}},
    {"expect": {"gallery.speed": 0.15}},
    {"drag": {"from": {"node": "find:Speed", "at": [100, 60]}, "to": {"node": "find:Speed", "at": [203, 60]}, "ms": 200}},
    {"expect": {"gallery.speed": {"near": 0.4, "tol": 0.011}}},
    {"drag": {"from": {"node": "find:Trim", "at": [300, 60]}, "to": {"node": "find:Trim", "at": [217.6, 60]}, "ms": 200}},
    {"expect": {"gallery.trim": 6.5}},
    {"drag": {"from": {"node": "find:Snap", "at": [100, 60]}, "to": {"node": "find:Snap", "at": [200, 60]}, "ms": 200}},
    {"expect": {"gallery.snap": 0.75}},
    {"tap": {"node": "find:Mode", "at": [40, 76]}},
    {"expect": {"gallery.mode": "driver"}},
    {"drag": {"from": {"node": "find:Msaa", "at": [40, 76]}, "to": {"node": "find:Msaa", "at": [190, 76]}, "ms": 200}},
    {"expect": {"gallery.msaa": 4}},
    {"tap": "find:Host"},
    {"expect": {"touch.keyboard.open": true, "touch.keyboard.numeric": false}},
    {"tap": "Keyboard/Sheet/Key_1"}, {"tap": "Keyboard/Sheet/Key_0"}, {"tap": "Keyboard/Sheet/Key_DOT"}, {"tap": "Keyboard/Sheet/Key_SHIFT"}, {"tap": "Keyboard/Sheet/Key_a"}, {"tap": "Keyboard/Sheet/Key_b"},
    {"expect": {"gallery.host": "10.Ab"}},
    {"tap": "Keyboard/Sheet/Key_BKSP"},
    {"screenshot": "keyboard"},
    {"tap": "Keyboard/Sheet/Key_DONE"},
    {"expect": {"gallery.host": "10.A", "touch.keyboard.open": false}},
    {"tap": "find:Port"},
    {"expect": {"touch.keyboard.numeric": true}},
    {"tap": "Keyboard/Sheet/Key_5"}, {"tap": "Keyboard/Sheet/Key_8"}, {"tap": "Keyboard/Sheet/Key_1"}, {"tap": "Keyboard/Sheet/Key_0"},
    {"screenshot": "keypad"},
    {"tap": [200, 40]},
    {"expect": {"gallery.port": "5810", "touch.keyboard.open": false}},
    {"tap": "find:Save"},
    {"expect": {"gallery.presses": 1}},
    {"mouse": true},
    {"tap": {"node": "find:Speed", "at": [20, 60]}},
    {"expect": {"gallery.speed": {"near": 0.4, "tol": 0.011}}},
    {"drag": {"from": {"node": "find:Speed", "at": [300, 60]}, "to": {"node": "find:Speed", "at": [196.8, 60]}, "ms": 200}},
    {"expect": {"gallery.speed": {"near": 0.15, "tol": 0.011}}},
    {"drag": {"from": {"node": "find:Trim", "at": [100, 60]}, "to": {"node": "find:Trim", "at": [244.2, 60]}, "ms": 200}},
    {"expect": {"gallery.trim": -0.5}},
    {"tap": {"node": "find:Mode", "at": [116, 76]}},
    {"expect": {"gallery.mode": "follow"}},
    {"tap": {"node": "find:Msaa", "at": [40, 76]}},
    {"expect": {"gallery.msaa": 0}},
    {"tap": "find:Port"},
    {"tap": "Keyboard/Sheet/Key_CLEAR"}, {"tap": "Keyboard/Sheet/Key_1"}, {"tap": "Keyboard/Sheet/Key_DONE"},
    {"expect": {"gallery.port": "1"}},
    {"tap": "find:Save"},
    {"expect": {"gallery.presses": 2}},
    {"mouse": false},
    {"swipe": {"from": {"node": "find:Speed", "at": [200, 60]}, "to": {"node": "find:Speed", "at": [205, 420]}, "ms": 200}},
    {"wait_ms": 350},
    {"expect": {"state.active_tab": "", "gallery": null}}
  ]
}
