{"extends": "touch_m6_base",
 "touch": {"active_tab": "auto", "view_auto": "Ball Shooter Right"},
 "preview": {"realtime": true},
 "nt": {"/AdvantageKit/RealOutputs/PathPlanner/ValidNames/Autos": ["Ball Shooter Left", "Ball Shooter Right", "Climber Right Left",
   "Climber Right Middle", "Climber Right Right", "Move Forward And Shoot Center", "Move Forward And Shoot Left",
   "Move Forward And Shoot Right", "Stay And Shoot", "Event Fix Auto"]},
 "input": [
  {"wait_ms": 300},
  {"expect": {"auto_tab.summary": "10 autos · event update\nexported 2999-01-02 03:04 UTC", "auto_tab.card_count": 11,
    "auto_tab.cards.Ball Shooter Right.warning": "Event copy broken: older preview",
    "auto_tab.cards.Event Fix Auto.warning": "Preview failed to load",
    "auto_tab.cards.Ball Shooter Left.warning": "",
    "auto_tab.viewing": "Ball Shooter Right", "auto_tab.no_preview": false, "auto_tab.detail_warning": {"ne": ""},
    "auto_tab.preview.auto": "Ball Shooter Right"}},
  {"tap": "find:PlayPause"},
  {"wait_ms": 1000},
  {"expect": {"autos.playing": true, "autos.t": {"ge": 0.5}, "auto_tab.preview.robot_error_m": {"le": 0.05}}},
  {"screenshot": "fallback_playing"},
  {"tap": "find:PlayPause"},
  {"drag": {"from": "find:List", "to": {"node": "find:List", "offset": [0, -2000]}, "ms": 300}},
  {"wait_ms": 300},
  {"tap": "find:Card_Event_Fix_Auto"},
  {"wait_ms": 200},
  {"expect": {"auto_tab.viewing": "Event Fix Auto", "auto_tab.no_preview": true, "auto_tab.no_preview_title": "Failed to load preview",
    "auto_tab.expanded": false}},
  {"screenshot": "failed"},
  {"tap": "find:ReloadAutos"},
  {"wait_ms": 200},
  {"expect": {"auto_tab.viewing": "Event Fix Auto", "auto_tab.no_preview_title": "Failed to load preview"}}
 ]}
