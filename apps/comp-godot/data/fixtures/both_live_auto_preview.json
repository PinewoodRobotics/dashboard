      "minimap.auto_overlay": {"ne": ""}, "minimap.mirroring": false}, "timeout_ms": 1500},
    {"expect": {"autos.hud.start.dist_m": {"ge": 0.0}, "autos.hud.start.heading_deg": {"ge": 0.0}, "auto_tab.start_chip": {"ne": ""}}},
    {"window": "hud", "screenshot": "hud_path"},
    {"window": "touch"},
    {"tap": "find:PlayPause"},
    {"wait_ms": 1500},
    {"expect": {"autos.playing": true, "autos.hud.mirror": true, "minimap.mirroring": true, "max_rendering_views": {"le": 2}, "autos.hud.start": {}}},
    {"window": "hud", "screenshot": "hud_mirror"},
