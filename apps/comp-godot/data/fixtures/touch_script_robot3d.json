{
  "extends": "touch_base",
  "nt": {
    "/AdvantageKit/RealOutputs/Turret/PositionRot": null,
    "/AdvantageKit/RealOutputs/IntakeSubsystem/WristPosition": null
  },
  "touch": {
    "active_tab": "robot3d"
  },
  "input": [
    {
      "expect": {
        "robot3d.turret.disabled": false,
        "robot3d.turret.source": "Manual fallback: Turret/PositionRot",
        "touch.driver.rendering": false
      }
    },
    {
      "drag": {
        "from": {
          "node": "find:Joint_turret/Slider",
          "at": [
            40,
            45
          ]
        },
        "to": {
          "node": "find:Joint_turret/Slider",
          "at": [
            130,
            45
          ]
        },
        "ms": 250
      }
    },
    {
      "expect": {
        "telemetry.manual.turret": {
          "ge": 1.0
        },
        "telemetry.targets.turret": {
          "ge": 1.0
        },
        "telemetry.targets.turret_gear": {
          "le": -1.0
        }
      }
    },
    {
      "screenshot": "turret_moved"
    },
    {
      "tap": "find:Joint_turret/Reset"
    },
    {
      "expect": {
        "telemetry.manual.turret": 0.0,
        "robot3d.turret.value": 0.0
      }
    },
    {
      "drag": {
        "from": {
          "node": "find:Joint_index_wrist/Slider",
          "at": [
            150,
            45
          ]
        },
        "to": {
          "node": "find:Joint_index_wrist/Slider",
          "at": [
            60,
            45
          ]
        },
        "ms": 250
      }
    },
    {
      "expect": {
        "telemetry.manual.index_wrist": {
          "le": -0.5
        }
      }
    },
    {
      "tap": "find:ResetAll"
    },
    {
      "expect": {
        "telemetry.manual.index_wrist": 0.0,
        "max_rendering_views": {
          "le": 2
        }
      }
    },
    {
      "mark": "cam0"
    },
    {
      "drag": {
        "from": {
          "node": "find:Robot3DView",
          "offset": [
            0,
            0
          ]
        },
        "to": {
          "node": "find:Robot3DView",
          "offset": [
            100,
            0
          ]
        },
        "ms": 150
      }
    },
    {
      "wait_ms": 400
    },
    {
      "expect": {
        "robot3d.camera.theta": {
          "changed_since": "cam0"
        },
        "robot3d.camera.target": {
          "same_as": "cam0",
          "tol": 1e-06
        }
      }
    },
    {
      "mark": "cam1"
    },
    {
      "pinch": {
        "at": "find:Robot3DView",
        "from": 200,
        "to": 200,
        "pan": [
          120,
          0
        ],
        "ms": 200
      }
    },
    {
      "wait_ms": 400
    },
    {
      "expect": {
        "robot3d.camera.target": {
          "changed_since": "cam1"
        },
        "robot3d.camera.dist": {
          "same_as": "cam1",
          "tol": 0.01
        }
      }
    },
    {
      "screenshot": "orbited"
    }
  ]
}